{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "react-jsx", "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "baseUrl": ".", "paths": { "@/*": ["./web/*"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"]
  },
  "include": ["web/**/*.ts", "web/components/**/*.tsx", "web/App.tsx", "vite.config.ts"],
  "exclude": ["web/vendor/grok-bot/upstream-renderer.tsx"]
}
