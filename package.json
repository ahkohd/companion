{
  "name": "companion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/ensure-grok-clips.mjs && node scripts/build-thumbnails.mjs && tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env bridge/server.mjs",
    "test": "node scripts/ensure-grok-clips.mjs && node scripts/build-face-profiles.mjs --check && node --test test/*.test.mjs scripts/grok-source/capture.test.mjs web/components/face/face-timeline.test.mjs",
    "animations:generate": "node scripts/build-grok-clips.mjs",
    "faces:generate": "node scripts/build-face-profiles.mjs",
    "fonts:generate": "node scripts/build-fonts.mjs",
    "check": "pnpm test && pnpm run build",
    "firmware:setup": "bash scripts/setup-firmware.sh",
    "firmware:build": "bash scripts/build-firmware.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "node-roon-api": "github:RoonLabs/node-roon-api#055dae6c2ac45b6c738aa3b9e5ac1fd722ed60e8",
    "node-roon-api-image": "github:RoonLabs/node-roon-api-image#a5f0efaf2dfb5457e91abe326c3a40d865131d32",
    "node-roon-api-transport": "github:RoonLabs/node-roon-api-transport#2ee60008a4cdb90c34ff3de58bb4b949067f1d20",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "serialport": "13.0.0",
    "shadcn": "^4.21.0",
    "sharp": "0.34.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "lv_font_conv": "1.5.3",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "packageManager": "pnpm@11.19.0",
  "license": "MIT"
}
