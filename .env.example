# Leave empty for browser-only use. Set your board's USB port after flashing.
# macOS ports commonly start /dev/cu.usbmodem; Linux ports start /dev/ttyACM.
ESP_SERIAL_PORT=

# Optional: override the default Herdr session socket.
# HERDR_SOCKET_PATH=/Users/you/.config/herdr/herdr.sock
# PORT=4317

# Optional: keep studio settings at a different local path.
# STUDIO_SETTINGS_PATH=/path/to/studio-settings.json
